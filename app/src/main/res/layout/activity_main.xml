<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexa_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            style="@style/NexaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/NexaSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                style="@style/NexaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_hint" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:columnCount="2">

                <Button
                    android:id="@+id/btnProducts"
                    style="@style/NexaTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/tile_margin"
                    android:backgroundTint="@color/tile_peach"
                    android:text="@string/tile_products" />

                <Button
                    android:id="@+id/btnCustomers"
                    style="@style/NexaTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/tile_margin"
                    android:backgroundTint="@color/tile_sky"
                    android:text="@string/tile_customers" />

                <Button
                    android:id="@+id/btnSale"
                    style="@style/NexaTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/tile_margin"
                    android:backgroundTint="@color/tile_mint"
                    android:text="@string/tile_sale" />

                <Button
                    android:id="@+id/btnPurchase"
                    style="@style/NexaTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/tile_margin"
                    android:backgroundTint="@color/tile_lilac"
                    android:text="@string/tile_purchase" />

                <Button
                    android:id="@+id/btnReports"
                    style="@style/NexaTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="2"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="@dimen/tile_margin"
                    android:backgroundTint="@color/tile_butter"
                    android:text="@string/tile_reports" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>