<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexa_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        style="@style/NexaHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_reports" />

    <Spinner
        android:id="@+id/spReport"
        style="@style/NexaSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:entries="@array/report_types" />

    <ListView
        android:id="@+id/listReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tvReportTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:elevation="8dp"
        android:gravity="center"
        android:padding="@dimen/space_l"
        android:textColor="@color/nexa_accent"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>