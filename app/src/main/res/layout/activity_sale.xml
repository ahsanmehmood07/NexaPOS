<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexa_bg"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/header"
        style="@style/NexaHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="@string/menu_sale" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomPanel"
        android:layout_below="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <LinearLayout
                style="@style/NexaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/NexaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="0dp"
                    android:text="@string/label_product" />

                <Spinner
                    android:id="@+id/spProduct"
                    style="@style/NexaSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" />

                <TextView
                    style="@style/NexaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_price" />

                <TextView
                    android:id="@+id/tvPrice"
                    style="@style/NexaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/money_zero"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/nexa_muted"
                    android:textSize="13sp" />

                <TextView
                    style="@style/NexaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_quantity" />

                <EditText
                    android:id="@+id/etQty"
                    style="@style/NexaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:hint="@string/hint_qty"
                    android:inputType="number" />

                <TextView
                    style="@style/NexaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_payment" />

                <RadioGroup
                    android:id="@+id/rgPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_m"
                        android:buttonTint="@color/nexa_accent"
                        android:checked="true"
                        android:text="@string/pay_cash"
                        android:textColor="@color/nexa_ink" />

                    <RadioButton
                        android:id="@+id/rbCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_m"
                        android:buttonTint="@color/nexa_accent"
                        android:text="@string/pay_card"
                        android:textColor="@color/nexa_ink" />

                    <RadioButton
                        android:id="@+id/rbCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/nexa_accent"
                        android:text="@string/pay_credit"
                        android:textColor="@color/nexa_ink" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvDiscount"
                    style="@style/NexaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/discount_zero" />

                <SeekBar
                    android:id="@+id/seekDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"
                    android:progress="0"
                    android:progressTint="@color/nexa_accent"
                    android:thumbTint="@color/nexa_accent" />

                <Button
                    android:id="@+id/btnSelectCustomer"
                    style="@style/NexaButton.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/btn_select_customer" />

                <TextView
                    android:id="@+id/tvCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:text="@string/customer_none"
                    android:textColor="@color/nexa_muted" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_panel"
        android:elevation="8dp"
        android:padding="@dimen/space_m">

        <TextView
            android:id="@+id/tvTotalLabel"
            style="@style/NexaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/tvTotal"
            android:layout_alignParentStart="true"
            android:paddingTop="0dp"
            android:text="@string/label_total" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/money_zero"
            android:textColor="@color/nexa_accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCompleteSale"
            style="@style/NexaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTotal"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/btn_complete_sale" />
    </RelativeLayout>
</RelativeLayout>