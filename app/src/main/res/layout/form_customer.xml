<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_m">

    <LinearLayout
        style="@style/NexaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/NexaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:text="@string/label_customer_name" />

        <EditText
            android:id="@+id/etCustomerName"
            style="@style/NexaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/hint_customer_name"
            android:inputType="textCapWords" />

        <TextView
            style="@style/NexaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_phone" />

        <EditText
            android:id="@+id/etPhone"
            style="@style/NexaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/hint_phone"
            android:inputType="phone" />

        <TextView
            style="@style/NexaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_address" />

        <EditText
            android:id="@+id/etAddress"
            style="@style/NexaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="top"
            android:hint="@string/hint_address"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <TextView
            style="@style/NexaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_customer_type" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbRetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_l"
                android:buttonTint="@color/nexa_accent"
                android:checked="true"
                android:text="@string/type_retail"
                android:textColor="@color/nexa_ink" />

            <RadioButton
                android:id="@+id/rbWholesale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/nexa_accent"
                android:text="@string/type_wholesale"
                android:textColor="@color/nexa_ink" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddCustomer"
                style="@style/NexaButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/btn_add_customer" />

            <Button
                android:id="@+id/btnClearCustomer"
                style="@style/NexaButton.Soft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/btn_clear" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/NexaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_xs"
        android:text="@string/list_customers" />
</LinearLayout>