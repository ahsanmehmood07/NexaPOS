<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NexaHeader">
        <item name="android:textColor">@color/nexa_ink</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>
    <style name="NexaTitle">
        <item name="android:textColor">@color/nexa_ink</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NexaSubtitle">
        <item name="android:textColor">@color/nexa_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="NexaLabel">
        <item name="android:textColor">@color/nexa_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">@dimen/space_m</item>
    </style>
    <style name="NexaInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">@dimen/field_pad</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/nexa_ink</item>
        <item name="android:textColorHint">@color/nexa_hint</item>
    </style>
    <style name="NexaSpinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">@dimen/field_pad</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">@dimen/field_pad</item>
        <item name="android:paddingBottom">@dimen/field_pad</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="NexaCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>
    <style name="NexaButton">
        <item name="android:backgroundTint">@color/nexa_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">@dimen/btn_pad</item>
        <item name="cornerRadius">@dimen/radius</item>
    </style>
    <style name="NexaButton.Soft">
        <item name="android:backgroundTint">@color/nexa_accent_soft</item>
        <item name="android:textColor">@color/nexa_accent</item>
    </style>
    <style name="NexaTile" parent="NexaButton">
        <item name="android:textColor">@color/nexa_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">@dimen/tile_height</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>